APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bsspos
DB_USERNAME=root
DB_PASSWORD=

# The `database` cache store and `database` queue connection must ALWAYS
# resolve against the central connection, never the app's "current default"
# connection (SwitchTenantConnection sets database.default to `tenant` on
# every tenant request, and the cache/jobs/failed_jobs tables only exist in
# the central database). Pin these explicitly to DB_CONNECTION rather than
# leaving them to fall back to whatever is currently the default connection.
DB_CACHE_CONNECTION="${DB_CONNECTION}"
DB_QUEUE_CONNECTION="${DB_CONNECTION}"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Comma-separated list of allowed origins for api/admin/commerce/electronics/mcp.
# Leave unset (or empty) to allow NO cross-origin requests. Never use "*" in
# production — set this explicitly per environment instead.
CORS_ALLOWED_ORIGINS=
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
